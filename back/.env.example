MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/aqi_db?retryWrites=true&w=majority
DB_NAME=aqi_db
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
TERMS_VERSION=2026-10
ACADEMIC_DOMAIN_ALLOWLIST=ac.in,edu,edu.in
GOVT_DOMAIN_SUFFIXES=gov.in,nic.in
PASSWORD_MIN_LENGTH=10
MFA_CHALLENGE_EXPIRE_MINUTES=5
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW_SECONDS=900
ORG_APPLY_RATE_LIMIT=10
ORG_APPLY_RATE_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT=30
LOGIN_RATE_WINDOW_SECONDS=900
RESEND_RATE_LIMIT=3
RESEND_RATE_WINDOW_SECONDS=900
EMAIL_VERIFICATION_EXPIRE_MINUTES=30
INVITE_EXPIRE_DAYS=7
# SMTP is optional in development. Without it, links are written to email_outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@envplatform.local
SMTP_STARTTLS=true
# Used only by: python -m app.scripts.bootstrap_admin
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
