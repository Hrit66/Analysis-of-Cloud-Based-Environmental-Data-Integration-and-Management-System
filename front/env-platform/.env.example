# Local dev: leave empty. Vite proxies /api -> http://127.0.0.1:8000 (see vite.config.js).
#
# Vercel: also leave empty. vercel.json rewrites /api/* to the Render backend, so the
# browser talks to one origin and the refresh-token cookie works with SameSite=lax.
#
# Only set this if you want the browser to call Render directly (then set
# COOKIE_SAMESITE=none on Render and add the Vercel URL to FRONTEND_ORIGINS):
# VITE_API_URL=https://envplatform-api.onrender.com/api
VITE_API_URL=
